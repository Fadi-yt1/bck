# Copy to .env for local development (`netlify dev`).
# In production these live in Netlify's encrypted environment variables,
# never in this repository.

# Live Photoroom key — consumes account credits.
PHOTOROOM_API_KEY=sk_pr_xxx_your_live_key_here

# Sandbox key — free, returns a watermarked result. Used when PHOTOROOM_MODE=sandbox.
PHOTOROOM_SANDBOX_API_KEY=sandbox_sk_pr_xxx_your_sandbox_key_here

# "live" or "sandbox". Controls which key the server uses.
PHOTOROOM_MODE=live

# Requests allowed per IP per rolling hour (protects your credits).
RATE_LIMIT_PER_HOUR=40

# Salt used to hash visitor IPs in the rate limiter. Any long random string.
RATE_LIMIT_SALT=change-me-to-a-long-random-string
